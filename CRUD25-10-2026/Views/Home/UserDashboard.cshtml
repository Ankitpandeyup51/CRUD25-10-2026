@model System.Data.DataTable

@{
    ViewBag.Title = "User Dashboard";
    var row = Model != null && Model.Rows.Count > 0
        ? Model.Rows[0]
        : null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>User Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f1f5f9;
            font-family: Arial, sans-serif;
            color: #1e293b;
            margin: 0;
        }

        .dashboard {
            max-width: 950px;
            margin: 45px auto;
            padding: 20px;
        }

        .topbar {
            background: #172554;
            color: white;
            padding: 28px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
        }

        .profile-icon {
            width: 75px;
            height: 75px;
            background: #dbeafe;
            color: #1d4ed8;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin-right: 20px;
            flex-shrink: 0;
        }

        .welcome {
            display: flex;
            align-items: center;
        }

        .topbar h2 {
            margin: 0 0 8px;
            font-weight: 700;
        }

        .topbar p {
            margin: 0;
            color: #cbd5e1;
        }

        .profile-card {
            background: white;
            margin-top: 25px;
            padding: 35px;
            border-radius: 16px;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.06);
        }

        .profile-heading {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .subtitle {
            color: #64748b;
            margin-bottom: 25px;
        }

        .profile-item {
            display: flex;
            align-items: center;
            gap: 18px;
            padding: 18px 0;
            border-bottom: 1px solid #e2e8f0;
        }

        .item-icon {
            width: 45px;
            height: 45px;
            background: #eff6ff;
            color: #2563eb;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
            flex-shrink: 0;
        }

        .item-label {
            color: #64748b;
            font-size: 13px;
            margin-bottom: 5px;
        }

        .item-value {
            font-size: 16px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .actions {
            display: flex;
            gap: 12px;
            margin-top: 28px;
        }

            .actions a {
                text-decoration: none;
                padding: 12px 20px;
                border-radius: 9px;
                font-weight: 600;
                text-align: center;
            }

        .edit-btn {
            background: #2563eb;
            color: white;
        }

            .edit-btn:hover {
                background: #1d4ed8;
                color: white;
            }

        .logout-btn {
            background: #f1f5f9;
            color: #334155;
        }

            .logout-btn:hover {
                background: #e2e8f0;
                color: #0f172a;
            }

        .empty-message {
            background: white;
            padding: 35px;
            border-radius: 16px;
            text-align: center;
            margin-top: 25px;
        }

        @@media (max-width: 600px) {
            .dashboard {
                margin: 15px auto;
                padding: 12px;
            }

            .topbar {
                padding: 20px;
            }

            .profile-icon {
                width: 55px;
                height: 55px;
                font-size: 24px;
                margin-right: 13px;
            }

            .topbar h2 {
                font-size: 21px;
            }

            .profile-card {
                padding: 22px;
            }

            .actions {
                flex-direction: column;
            }

                .actions a {
                    width: 100%;
                }
        }
    </style>
</head>

<body>
    <div class="dashboard">

        <div class="topbar">
            <div class="welcome">
                <div class="profile-icon">
                    <i class="fa-solid fa-user"></i>
                </div>

                <div>
                    <h2>User Dashboard</h2>
                    <p>
                        Welcome back,
                        @(row != null ? Convert.ToString(row["Name"]) : "User")!
                    </p>
                </div>
            </div>

            <i class="fa-regular fa-bell fa-xl"></i>
        </div>

        @if (row != null)
        {
            <div class="profile-card">

                <h3 class="profile-heading">My Profile</h3>
                <p class="subtitle">
                    View your personal information
                </p>

                <div class="profile-item">
                    <div class="item-icon">
                        <i class="fa-solid fa-id-card"></i>
                    </div>
                    <div>
                        <div class="item-label">User ID</div>
                        <div class="item-value">@row["Id"]</div>
                    </div>
                </div>

                <div class="profile-item">
                    <div class="item-icon">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <div>
                        <div class="item-label">Full Name</div>
                        <div class="item-value">@row["Name"]</div>
                    </div>
                </div>

                <div class="profile-item">
                    <div class="item-icon">
                        <i class="fa-solid fa-envelope"></i>
                    </div>
                    <div>
                        <div class="item-label">Email Address</div>
                        <div class="item-value">@row["Email"]</div>
                    </div>
                </div>

                <div class="profile-item">
                    <div class="item-icon">
                        <i class="fa-solid fa-phone"></i>
                    </div>
                    <div>
                        <div class="item-label">Phone Number</div>
                        <div class="item-value">@row["Phone"]</div>
                    </div>
                </div>

                <div class="profile-item">
                    <div class="item-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>
                    <div>
                        <div class="item-label">Date of Birth</div>
                        <div class="item-value">
                            @(row["Dob"] == DBNull.Value
                                ? "Not provided"
                                : Convert.ToDateTime(row["Dob"]).ToString("dd MMM yyyy"))
                        </div>
                    </div>
                </div>

                <div class="profile-item">
                    <div class="item-icon">
                        <i class="fa-solid fa-venus-mars"></i>
                    </div>
                    <div>
                        <div class="item-label">Gender</div>
                        <div class="item-value">@row["Gender"]</div>
                    </div>
                </div>

                <div class="profile-item">
                    <div class="item-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <div>
                        <div class="item-label">Address</div>
                        <div class="item-value">@row["Address"]</div>
                    </div>
                </div>

                <div class="actions">
                    <a href="@Url.Action("Update", "Home", new { id = row["Id"] })"
                       class="edit-btn">
                        <i class="fa-solid fa-pen-to-square me-2"></i>
                        Edit Profile
                    </a>

                    <a href="@Url.Action("Logout", "Home")"
                       class="logout-btn">
                        <i class="fa-solid fa-right-from-bracket me-2"></i>
                        Logout
                    </a>
                </div>

            </div>
        }
        else
        {
            <div class="empty-message">
                <i class="fa-solid fa-user-slash fa-3x text-secondary mb-3"></i>
                <h4>No Profile Found</h4>
                <p class="text-secondary">
                    We could not find your profile information.
                </p>
            </div>
        }

    </div>
</body>
</html>
