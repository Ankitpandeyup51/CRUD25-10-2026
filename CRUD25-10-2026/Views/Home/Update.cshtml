@model System.Data.DataTable
@{
    ViewBag.Title = "Update";
}

<h2>Update</h2>\

@if (Model != null && Model.Rows.Count > 0)
        {
            System.Data.DataRow row = Model.Rows[0];
           
    <form method="post">
        <label class="form-label">Id:</label>
        <input type="text" value="@row["id"]" name="id" readonly class="form-control" />
        <label class="form-label">Name:</label>
        <input type="text" value="@row["name"]" name="name" class="form-control" />
        <label class="form-label">Email:</label>
        <input type="text" value="@row["email"]" name="email" class="form-control" />
        <label class="form-label">Phone:</label>
        <input type="number" value="@row["phone"]" name="phone" class="form-control" />
        <label class="form-label">Dob:</label>
        <input type="date" name="dob" value='@(Convert.ToDateTime(row["dob"]).ToString("yyyy-MM-dd"))' />
        <label class="form-label">Address:</label>
        <input type="text" placeholder="Address" value="@row["address"]" name="address" class="form-control" />
        <label class="form-label">Gender:</label>
        Male: <input type="radio" name="gender" value="Male" @(row["gender"].ToString() == "Male" ? "checked" : "")>Female:
        <input type="radio" name="gender" value="Female" @(row["gender"].ToString() == "Female" ? "checked" : "") /> Other
        <input type="radio" name="gender" value="Other" @(row["gender"].ToString() == "Other" ? "checked" : "") /><br />
        <label class="form-label">Password:</label>
        <input type="text"  value="@row["password"]" name="password" class="form-control" />
        <label class="form-label">Confirm Password:</label>
        <input type="text"  value="@row["password"]" name="c_password" class="form-control" />

        <button type="submit" class="btn btn-success">Submit</button>
        <button type="reset" class="btn btn-info">Reset</button>


    </form>

}
